{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform_live/1.1.0/staff_dimensions.schema.json",
  "title": "staff_dimensions",
  "description": "platform_live row from source table `staff` (mutable, optimistic version).",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^STF-.+$"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "analyst",
          "supervisor",
          "admin"
        ]
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "es",
          "pt"
        ]
      }
    },
    "team": {
      "type": [
        "string",
        "null"
      ]
    },
    "team_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "active": {
      "type": "boolean"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "id",
    "roles",
    "languages",
    "active",
    "version"
  ],
  "additionalProperties": false,
  "x-primary-key": [
    "id"
  ],
  "x-denied-columns": [
    "name",
    "email"
  ],
  "x-contract-version": "1.1.0"
}
