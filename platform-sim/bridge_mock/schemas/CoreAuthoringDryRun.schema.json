{
  "$id": "CoreAuthoringDryRun.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "auto_bumped": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "version"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "candidate_hash": {
      "oneOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "content_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "new_versions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "version"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "proposal_created": {
      "const": false
    },
    "release_hash": {
      "oneOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "release_id_preview": {
      "oneOf": [
        {
          "pattern": "^rel-[0-9a-f]{16}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_profile": {
      "enum": [
        "contract_mock",
        "agent_core_real"
      ]
    },
    "schema_version": {
      "const": "1",
      "type": "string"
    },
    "valid": {
      "type": "boolean"
    },
    "violations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "flow": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "node_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "rule": {
            "type": "string"
          }
        },
        "required": [
          "rule",
          "path",
          "flow",
          "node_id",
          "message"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "auto_bumped",
    "candidate_hash",
    "content_hashes",
    "new_versions",
    "proposal_created",
    "release_hash",
    "release_id_preview",
    "request_digest",
    "runtime_profile",
    "schema_version",
    "valid",
    "violations"
  ],
  "title": "CoreAuthoringDryRun",
  "type": "object"
}
