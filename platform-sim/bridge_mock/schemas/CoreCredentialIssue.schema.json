{
  "$id": "CoreCredentialIssue.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "exp": {
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d+)?Z$",
      "type": "string"
    },
    "jws": {
      "minLength": 10,
      "type": "string"
    },
    "kid": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "runtime_profile": {
      "const": "contract_mock"
    },
    "schema_version": {
      "const": "1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "jws",
    "kid",
    "exp",
    "runtime_profile"
  ],
  "title": "CoreCredentialIssue",
  "type": "object"
}
