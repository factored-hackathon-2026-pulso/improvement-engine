      "minLength": 1,
      "type": "string"
    },
    "base_release_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "type": "object"
          },
          "docs": {
            "type": "object"
          },
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "content",
          "docs"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "request_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "agent_id",
    "base_release_id",
    "changes"
  ],
  "title": "CoreAuthoringDryRunRequest",
  "type": "object"
