{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pulso-factored/improvement-engine/contracts/source-contract.schema.json",
  "title": "Pulso readonly SourceContract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source_namespace", "source_kind", "table", "primary_key", "event_clock", "read_only", "access_policy", "columns"],
  "properties": {
    "contract_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {"major": {"const": 1}, "minor": {"type": "integer", "minimum": 0}}
    },
    "source_namespace": {"type": "string", "minLength": 1},
    "source_kind": {"const": "original"},
    "table": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "primary_key": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "event_clock": {"type": "string", "minLength": 1},
    "read_only": {"const": true},
    "access_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permitted_classifications"],
      "properties": {
        "permitted_classifications": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["internal", "pseudonymized", "aggregated"]},
          "uniqueItems": true
        }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "logical_type", "nullable", "purpose", "classification"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "logical_type": {"enum": ["text", "timestamp", "date", "bool", "decimal", "int"]},
          "nullable": {"type": "boolean"},
          "purpose": {"enum": ["identity", "join", "event_clock", "metric", "dimension", "quality"]},
          "classification": {"enum": ["internal", "pseudonymized", "aggregated", "restricted"]}
        }
      }
    }
  }
}
