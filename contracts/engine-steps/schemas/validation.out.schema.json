{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine-steps/validation.out",
  "title": "validation step output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "step",
    "run_id",
    "data_class",
    "signal_id",
    "verdict",
    "check_results",
    "verifier_actor"
  ],
  "properties": {
    "contract_version": {
      "const": "engine-steps/0"
    },
    "step": {
      "const": "validation"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "data_class": {
      "enum": [
        "synthetic",
        "treated",
        "e0",
        "original"
      ]
    },
    "signal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "verdict": {
      "enum": [
        "corroborated",
        "refuted",
        "inconclusive"
      ]
    },
    "check_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "status"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_applicable"
            ]
          }
        }
      }
    },
    "verifier_actor": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
      }
    }
  }
}
