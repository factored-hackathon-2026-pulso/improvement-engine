{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "engine-steps/validation.in",
  "title": "validation step input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "step",
    "run_id",
    "data_class",
    "signal_id",
    "recompute_ref",
    "checks",
    "scout_actor",
    "verifier_actor"
  ],
  "properties": {
    "contract_version": {
      "const": "engine-steps/0"
    },
    "step": {
      "const": "validation"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "data_class": {
      "enum": [
        "synthetic",
        "treated",
        "e0",
        "original"
      ]
    },
    "signal_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "recompute_ref": {
      "type": "string",
      "pattern": "^[a-z_]+:[A-Za-z0-9._-]+@[0-9]+$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "schema_coverage",
          "denominator",
          "temporality",
          "mix",
          "duplicates",
          "multiple_testing",
          "window_sensitivity",
          "counterexamples"
        ]
      }
    },
    "scout_actor": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "verifier_actor": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    }
  }
}
