{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "case_id",
    "agent_id",
    "route",
    "seed",
    "turns",
    "initial_state_digest",
    "oracle_ref",
    "data_class"
  ],
  "properties": {
    "contract_version": {
      "const": "engine-steps-pack/0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "text"
        ],
        "properties": {
          "role": {
            "enum": [
              "customer",
              "agent"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "initial_state_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "oracle_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_class": {
      "const": "synthetic"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ScenarioCase",
  "title": "ScenarioCase (C-8 draft)"
}
