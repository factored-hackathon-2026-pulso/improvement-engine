{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_bundle_ref",
    "opportunity_ref",
    "workflow_bridge_ref",
    "operations",
    "expected_mechanism",
    "affected_routes",
    "rollback_ref"
  ],
  "properties": {
    "base_bundle_ref": {
      "type": "string",
      "pattern": "^[a-z_]+:[A-Za-z0-9._-]+@[0-9]+$"
    },
    "opportunity_ref": {
      "type": "string",
      "pattern": "^[a-z_]+:[A-Za-z0-9._-]+@[0-9]+$"
    },
    "workflow_bridge_ref": {
      "type": "string",
      "pattern": "^[a-z_]+:[A-Za-z0-9._-]+@[0-9]+$"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "target_kind",
          "target_ref",
          "precondition_digest"
        ],
        "properties": {
          "op": {
            "enum": [
              "add",
              "replace",
              "disable"
            ]
          },
          "target_kind": {
            "enum": [
              "prompt",
              "eval_suite"
            ]
          },
          "target_ref": {
            "type": "string",
            "pattern": "^[a-z_]+:[A-Za-z0-9._-]+@[0-9]+$"
          },
          "new_ref": {
            "type": "string",
            "pattern": "^[a-z_]+:[A-Za-z0-9._-]+@[0-9]+$"
          },
          "precondition_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "expected_mechanism": {
      "type": "string",
      "minLength": 1
    },
    "affected_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback_ref": {
      "type": "string",
      "pattern": "^[a-z_]+:[A-Za-z0-9._-]+@[0-9]+$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ChangeSpec",
  "title": "ChangeSpec (C-8 draft, SMAP refines)"
}
