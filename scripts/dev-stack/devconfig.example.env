# Copy to devconfig.env at the repo root (gitignored) and uncomment what differs on your machine. Or point PULSO_DEVCONFIG at another file.
# Names only: NEVER put a key, token or password in this file (it only accepts these names; credentials live in the two env files below).
# Order: this file > environment variables > defaults relative to this repo > the original machine's D:\ layout.

# Checkouts (default: siblings of this repo)
# PULSO_AGENT_CORE_DIR=
# PULSO_LLM_GATEWAY_DIR=
# PULSO_PLATFORM_DIR=

# Credential files, outside any repo (default: ../.pulso-env/). Create them yourself; they are only read, never printed.
# PULSO_AGENT_CORE_ENV=
# PULSO_LLM_GATEWAY_ENV=

# Binaries (default: <CARGO_TARGET_DIR>/debug/pulso[.exe] and steps_cli[.exe]; CARGO_TARGET_DIR default: ./target)
# CARGO_TARGET_DIR=
# PULSO_EXE=
# PULSO_STEPS_EXE=

# Podman. Linux: leave unset (native podman). macOS/Windows: name of your rootful podman machine (connection <name>-root).
# An explicitly EMPTY value (PULSO_PODMAN_MACHINE=) means "use the default connection". PULSO_PODMAN_CONNECTION overrides both.
# PULSO_PODMAN_MACHINE=
# PULSO_PODMAN_CONNECTION=

# Stack prefix and ports of the integrated rig (defaults pulso-env1 / 55510 8210 8211 4210 8200 5174)
# PULSO_STACK_PREFIX=
# PULSO_RIG_PG_PORT=
# PULSO_RIG_GW_PORT=
# PULSO_RIG_CORE_PORT=
# PULSO_RIG_ENGINE_PORT=
# PULSO_RIG_PLATFORM_PORT=
# PULSO_RIG_SPA_PORT=

# Ports of the stand-alone demo loop (scripts/demo-loop/run.ps1) and its restricted bank data root (absent => use -Synthetic)
# PULSO_DEMO_PG_PORT=
# PULSO_DEMO_GW_PORT=
# PULSO_DEMO_CORE_PORT=
# PULSO_DEMO_ENGINE_PORT=
# PULSO_DEMO_DATA_ROOT=
