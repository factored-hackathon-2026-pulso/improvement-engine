# Copy values into an ignored local environment file or export them in PowerShell.
PULSO_POSTGRES_DB=pulso
PULSO_POSTGRES_USER=pulso
PULSO_POSTGRES_PASSWORD=
PULSO_POSTGRES_PORT=54329
PULSO_LOCALSTACK_PORT=4566

# Optional Grafana LGTM profile (only started with --profile observability).
PULSO_OTEL_GRAFANA_PORT=3000
PULSO_OTEL_GRPC_PORT=4317
PULSO_OTEL_HTTP_PORT=4318
PULSO_OTEL_METRICS_RETENTION=24h
PULSO_OTEL_LOGS_RETENTION=24h
PULSO_OTEL_TRACES_RETENTION=24h
