# Example only: start.ps1 generates the real file into local/.secrets/<ns>/core.env (git-ignored). No secrets here.
POSTGRES_PASSWORD=example-only
CORE_APP_PASSWORD=example-only
CORE_EVAL_APP_PASSWORD=example-only
EXPORTER_RO_PASSWORD=example-only
PULSO_TENANT_ID=tenant-local
PULSO_CORE_IMAGE=localhost/pulso-core-runtime:example
# real_local: broker/control-api/ingest are DOUBLES (platform-sim) until Codex's assembly provides them.
PULSO_LAB_BROKER_URL=http://platform-sim:8621
PULSO_CONTROL_API_URL=http://platform-sim:8621
