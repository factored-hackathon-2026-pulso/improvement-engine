    "note": "producer side only; Rust implements the receiver",
    "scopes": [
      "binding",
      "observations"
    ]
  },
  "idempotency": {
    "admissions": {
      "derivation": {
        "evaluation_context_ref": "'evc-' + sha256_hex('{tenant_id}|{job_id}|{binding_ref}|{proposal_id}|{candidate_hash}|{evaluation_attempt}')[:40]",
        "explicit_value": "optional; accepted only when equal to the derived ref (else 422 pulso:evaluation_context_invalid)",
        "job_id": "the `job_id` claim of the token"
      },
      "first": "201",
      "key": "Idempotency-Key header (validated [A-Za-z0-9_.:-]{1,200}, optional); the admission is identified by the derived ref below, so a replay is the same admission",
      "replay": "200 same body; 409 pulso:idempotency_conflict when any bound field differs"
    },
    "arms": {
      "execution_id": "'arm-' + sha256_hex('{tenant_id}|{idempotency_key}')[:32]",
      "key": "Idempotency-Key header or body.idempotency_key; both present must be equal (else 422 pulso:invalid_request details.fields=[Idempotency-Key]); neither -> 422",
      "readback": [
        "GET /evaluation/arms/{execution_id}",
        "GET /evaluation/arms/by-key/{key}"
      ],
      "replay": "200 stored report; other body -> 409 pulso:idempotency_conflict (alias and annex spellings of the same request share one digest)"
    },
    "invoke": {
      "formula": "sha256_hex('{tenant_id}|{job_id}|{stage}|{attempt}|{logical_key}')",
      "header": "Idempotency-Key",
      "request_digest": "sha256_hex(JCS(body minus request_digest, credentials, trace))",
      "same_key_other_digest": "409 pulso:digest_conflict",
      "same_key_same_digest": "replay: stored receipt (200 terminal / 202 non-terminal), no second Core run",
      "task_binding_ref": "sha256_hex('{tenant_id}|{idempotency_key}')",
      "wrong_header": "422 pulso:invalid_request details.fields=[Idempotency-Key]"
    }
  },
  "limits": {
    "credential_max_ttl_seconds": 900,
    "default_max_inflight": 8,
    "fact_cap_bytes": 131072,
    "max_body_bytes": 1048576,
    "max_input_bytes": 262144,
    "result_cap_bytes": 262144
  },
  "pin": {
    "agent_core_sha": "894fa65575d83420523f33ec1c6919b8965f7ebe",
    "contracts_version": "1.3.0"
  },
  "receipt_reasons": [
    "completed",
    "run_failed",
    "unexpected_outcome",
    "core_call_failed",
    "post_send_exception",
    "projection_failed",
    "binding_unconfirmed",
    "binding_unproven",
    "core_idempotency_conflict",
    "core_http_*",
    "core_rejected_*",
    "release_drift",
    "release_pin_unavailable",
    "release_revoked",
    "output_missing",
    "output_too_large",
    "fact_schema_violation",
    "canary_detected"
  ],
  "receipt_state_machine": {
    "http": {
      "non_terminal": 202,
      "note": "a timeout after `sent` is `unknown`, never `failed`; `unknown` never licenses repeating the effect",
      "terminal": 200
    },
    "states": [
      "prepared",
      "sent",
      "binding_confirmed",
      "terminal_ok",
      "terminal_failed",
      "unknown",
      "manual_reconcile"
    ],
    "terminal": [
      "terminal_failed",
      "terminal_ok"
    ],
    "transitions": {
      "binding_confirmed": [
        "sent"
      ],
      "manual_reconcile": [
        "binding_confirmed",
        "manual_reconcile",
        "prepared",
        "sent",
        "unknown"
      ],
      "sent": [
        "prepared"
      ],
      "terminal_failed": [
        "binding_confirmed",
        "manual_reconcile",
        "prepared",
        "sent",
        "unknown"
      ],
      "terminal_ok": [
        "binding_confirmed",
        "manual_reconcile",
        "sent",
        "unknown"
      ],
      "unknown": [
        "binding_confirmed",
        "sent",
        "unknown"
      ]
    }
  },
  "routes": [
