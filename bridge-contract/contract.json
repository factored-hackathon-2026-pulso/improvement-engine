    "token": {
      "alg": "EdDSA (verifier-fixed, never from payload)",
      "aud": "core-bridge",
      "claims_optional": [
        "job_id"
      ],
      "claims_required": [
        "iss",
        "aud",
        "sub",
        "tenant_id",
        "purpose",
        "iat",
        "exp",
        "jti"
      ],
      "header_exact_keys": [
        "alg",
        "kid",
        "typ"
      ],
      "iss": "control-api",
      "job_id_rule": "invoke: claim job_id must equal body job_id (403 pulso:auth_denied reason job_mismatch)",
      "jti": "receiver-owned durable replay store; (iss, jti) consumed atomically AFTER all other checks pass (a rejected token never burns its jti); every HTTP attempt uses a fresh jti",
      "key_binding": "each kid is bound to exactly one (iss, aud)",
      "max_exp_skew_seconds": 30,
      "max_ttl_seconds": 300,
      "scope_claim": "absent (class i has no scope)",
      "sub_pattern": "^worker:.+ (else 403 pulso:auth_denied reason sub_not_worker)",
      "typ": "JWT"
    }
  },
