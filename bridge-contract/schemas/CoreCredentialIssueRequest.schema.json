{
  "$id": "CoreCredentialIssueRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "CAP-33 credential request.",
  "properties": {
    "purpose": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "role": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "anyOf": [
        {
          "const": "1",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "role",
    "purpose"
  ],
  "title": "CoreCredentialIssueRequest",
  "type": "object",
  "x-policy": [
    {
      "purpose": "core_task",
      "role": "constructor",
      "signer": "identity"
    },
    {
      "purpose": "registry_write",
      "role": "constructor",
      "signer": "staff"
    }
  ]
}
