        "pulso:broker_denied",
        "pulso:budget_unknown",
        "pulso:canary_detected",
        "pulso:candidate_changed",
        "pulso:core_unavailable",
        "pulso:credential_not_issuable",
        "pulso:credential_signing_unavailable",
        "pulso:digest_conflict",
        "pulso:dry_run_unavailable",
        "pulso:evaluate_disabled",
