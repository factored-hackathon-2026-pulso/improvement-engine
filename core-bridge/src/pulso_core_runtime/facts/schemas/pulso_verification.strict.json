{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulso:fact:pulso_verification:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdicts"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1"]},
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "verdict", "evidence_refs"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "verdict": {"type": "string", "enum": ["supported", "refuted", "inconclusive"]},
          "evidence_refs": {
            "type": "array",
            "maxItems": 50,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"}
          }
        }
      }
    }
  }
}
