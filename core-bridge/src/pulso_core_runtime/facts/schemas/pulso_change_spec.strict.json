{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pulso:fact:pulso_change_spec:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_spec",
    "rationale",
    "evidence_refs",
    "alternatives"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "change_spec": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "digest",
          "media_type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "contains": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "do_nothing"
          }
        }
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "enum": [
              "do_nothing",
              "proposed_change"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "limitations": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 2000
            }
          }
        }
      }
    }
  }
}
