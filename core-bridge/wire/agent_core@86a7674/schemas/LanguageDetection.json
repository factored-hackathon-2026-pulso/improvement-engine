{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "additionalProperties": false,
  "description": "Configuración versionada de la detección de idioma, con detector fijado (M0 §2.4).",
  "properties": {
    "candidates": {
      "items": {
        "pattern": "^[a-z]{2}$",
        "type": "string"
      },
      "title": "Candidates",
      "type": "array"
    },
    "detector": {
      "pattern": "^[a-z][a-z0-9_-]*@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "title": "Detector",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_/-]*$",
      "title": "Id",
      "type": "string"
    },
    "min_letters": {
      "minimum": 0,
      "title": "Min Letters",
      "type": "integer"
    },
    "min_letters_unsupported": {
      "minimum": 0,
      "title": "Min Letters Unsupported",
      "type": "integer"
    },
    "thresholds_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Thresholds From"
    },
    "unsupported": {
      "items": {
        "type": "string"
      },
      "title": "Unsupported",
      "type": "array"
    },
    "version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "detector",
    "candidates",
    "min_letters",
    "min_letters_unsupported"
  ],
  "title": "LanguageDetection",
  "type": "object"
}
