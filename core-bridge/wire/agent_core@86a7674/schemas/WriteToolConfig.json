{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "RefSpec": {
      "additionalProperties": false,
      "description": "Referencia de autoría: exacta, rango (`^1`, `~1.2`, `1`) o sin versión.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "spec": {
          "anyOf": [
            {
              "pattern": "^(?:(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)|[\\^~](?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}|(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spec"
        }
      },
      "required": [
        "id"
      ],
      "title": "RefSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Escritura de un nodo `tool`.\n\nCon `action_from` usa la acción congelada de un `confirm` (ADR 0007) y no admite `tool` ni `args`.\nCon `draft: true` (ADR 0019) invoca una tool `write_draft` con sus propios `args`: no hay `confirm`; la\nacción se congela al entrar al nodo.",
  "properties": {
    "action_from": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action From"
    },
    "args": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Args",
      "type": "object"
    },
    "draft": {
      "default": false,
      "title": "Draft",
      "type": "boolean"
    },
    "save_as": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Save As",
      "type": "string"
    },
    "step_up_max_attempts": {
      "default": 2,
      "exclusiveMinimum": 0,
      "title": "Step Up Max Attempts",
      "type": "integer"
    },
    "tool": {
      "anyOf": [
        {
          "$ref": "#/$defs/RefSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "save_as"
  ],
  "title": "WriteToolConfig",
  "type": "object"
}
