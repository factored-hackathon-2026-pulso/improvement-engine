      "title": "ActionSpec",
      "type": "object"
    },
    "AgentNode": {
      "additionalProperties": false,
      "description": "Nodo `agent` de un flow (M0 §2.5).",
      "properties": {
        "config": {
          "$ref": "#/$defs/AgentNodeConfig"
