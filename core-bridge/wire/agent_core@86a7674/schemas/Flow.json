      "title": "AgentNode",
      "type": "object"
    },
    "AgentNodeConfig": {
      "additionalProperties": false,
      "description": "Configuration of the `agent` node (M0 §2.5, ADR 0019).\n\n`save_as` names the fact that receives the output; `output_schema` is the JSON Schema of that output.\n`input_view` lists the paths (`slots`, `facts`) the model sees in the `model` view; empty means none.",
      "properties": {
        "goal": {
          "title": "Goal",
          "type": "string"
        },
        "input_view": {
          "items": {
            "type": "string"
          },
          "title": "Input View",
          "type": "array"
        },
        "max_steps": {
          "exclusiveMinimum": 0,
          "title": "Max Steps",
          "type": "integer"
        },
        "output_schema": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Output Schema",
          "type": "object"
        },
        "prompt_ref": {
          "$ref": "#/$defs/RefSpec"
        },
        "save_as": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Save As",
          "type": "string"
        },
        "tools_allowed": {
          "items": {
            "$ref": "#/$defs/RefSpec"
          },
          "title": "Tools Allowed",
          "type": "array"
        }
      },
      "required": [
        "tools_allowed",
        "max_steps",
        "prompt_ref",
        "goal",
        "save_as",
        "output_schema"
      ],
      "title": "AgentNodeConfig",
      "type": "object"
    },
