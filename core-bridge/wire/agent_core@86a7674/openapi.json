{
  "components": {
    "schemas": {
      "AgentSelector": {
        "additionalProperties": false,
        "description": "Selector de agente del request: `id`, `id@alias` o `id@X.Y.Z`. Sin nada, alias `prod`.",
        "properties": {
          "alias": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alias"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9_/-]*$",
            "title": "Id",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "id"
        ],
        "title": "AgentSelector",
        "type": "object"
      },
      "ConfirmAnswer": {
        "additionalProperties": false,
        "description": "Respuesta del usuario (sí/no) a una confirmación, con su token (M0 §2.8).",
        "properties": {
          "answer": {
            "enum": [
              "yes",
              "no"
            ],
            "title": "Answer",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "answer"
        ],
        "title": "ConfirmAnswer",
        "type": "object"
      },
      "CreateRunBody": {
        "additionalProperties": false,
        "properties": {
          "agent": {
            "examples": [
              "atencion@prod"
            ],
            "type": "string"
          },
          "input": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input"
          },
          "lang": {
            "anyOf": [
              {
                "pattern": "^[a-z]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lang"
          },
          "subject": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SubjectRef"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "agent"
        ],
        "title": "CreateRunBody",
        "type": "object"
      },
      "JsonValue": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          },
          {
            "type": "string"
          },
          {
            "items": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "array"
          },
          {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "ProblemBody": {
        "additionalProperties": false,
        "description": "`application/problem+json` (M9 §3.5).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "trace_id"
        ],
        "title": "ProblemBody",
        "type": "object"
      },
      "ResolutionBody": {
        "additionalProperties": false,
        "properties": {
          "handoff_quality": {
            "enum": [
              "useful",
              "incomplete",
              "unnecessary"
            ],
            "title": "Handoff Quality",
            "type": "string"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "resolution_code": {
            "title": "Resolution Code",
            "type": "string"
          }
        },
        "required": [
          "resolution_code",
          "handoff_quality"
        ],
        "title": "ResolutionBody",
        "type": "object"
      },
      "SubjectRef": {
        "additionalProperties": false,
        "description": "Referencia al sujeto de un run (tipo y referencia opaca) (M0 §2.3).",
        "properties": {
          "kind": {
            "minLength": 1,
            "title": "Kind",
            "type": "string"
          },
          "ref": {
            "minLength": 1,
            "title": "Ref",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "title": "SubjectRef",
        "type": "object"
      },
      "TurnBody": {
        "additionalProperties": false,
        "properties": {
          "channel": {
            "title": "Channel",
            "type": "string"
          },
          "client_turn_id": {
            "title": "Client Turn Id",
            "type": "string"
          },
          "confirm": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConfirmAnswer"
              },
              {
                "type": "null"
              }
            ]
          },
          "lang": {
            "anyOf": [
              {
                "pattern": "^[a-z]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lang"
          },
          "text": {
            "default": "",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "channel",
          "client_turn_id"
        ],
        "title": "TurnBody",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "agent-core",
    "version": "1.0.0"
  },
