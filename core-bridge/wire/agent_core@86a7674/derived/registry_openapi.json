{
  "components": {
    "schemas": {
      "EntityDraft": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Content",
            "type": "object"
          },
          "docs": {
            "$ref": "#/components/schemas/VersionDocs"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "content",
          "docs"
        ],
        "title": "EntityDraft",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JsonValue": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          },
          {
            "type": "string"
          },
          {
            "items": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "array"
          },
          {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
      },
      "Origin": {
        "enum": [
          "manual",
          "builder_chat",
          "auto_detect",
          "import"
        ],
        "title": "Origin",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionDocs": {
        "additionalProperties": false,
        "properties": {
          "changelog": {
            "maxLength": 8000,
            "title": "Changelog",
            "type": "string"
          },
          "description": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "rationale": {
            "maxLength": 4000,
            "title": "Rationale",
            "type": "string"
          }
        },
        "required": [
          "description",
          "rationale",
          "changelog"
        ],
        "title": "VersionDocs",
        "type": "object"
      },
      "_Approve": {
        "properties": {
          "accept_yardstick_loosened": {
            "default": false,
            "title": "Accept Yardstick Loosened",
            "type": "boolean"
          },
          "candidate_hash": {
            "title": "Candidate Hash",
            "type": "string"
          }
        },
        "required": [
          "candidate_hash"
        ],
        "title": "_Approve",
        "type": "object"
      },
      "_Create": {
        "properties": {
          "agent_id": {
            "title": "Agent Id",
            "type": "string"
          },
          "origin": {
            "$ref": "#/components/schemas/Origin",
            "default": "manual"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "agent_id",
          "title"
        ],
        "title": "_Create",
        "type": "object"
      },
      "_Draft": {
        "properties": {
