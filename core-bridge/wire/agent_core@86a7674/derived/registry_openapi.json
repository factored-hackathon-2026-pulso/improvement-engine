          "suite_id": {
            "title": "Suite Id",
            "type": "string"
          },
          "suite_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suite Version"
          }
        },
        "required": [
          "suite_id"
        ],
        "title": "_Evaluate",
        "type": "object"
      },
      "_Promote": {
        "properties": {
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          },
          "release_id": {
            "title": "Release Id",
            "type": "string"
          }
        },
        "required": [
          "release_id"
        ],
        "title": "_Promote",
        "type": "object"
      },
      "_Reason": {
        "properties": {
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "_Reason",
        "type": "object"
      }
    }
