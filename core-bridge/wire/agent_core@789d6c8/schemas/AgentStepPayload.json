{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "EntityRef": {
      "additionalProperties": false,
      "description": "Referencia exacta de runtime: `id@X.Y.Z`.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "Fingerprint": {
      "additionalProperties": false,
      "description": "Huella con clave (ADR 0008): `value = HMAC-SHA256(k[kid], JCS(dato))`.",
      "properties": {
        "alg": {
          "const": "HMAC-SHA256",
          "title": "Alg",
          "type": "string"
        },
        "kid": {
          "title": "Kid",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "alg",
        "kid",
        "value"
      ],
      "title": "Fingerprint",
      "type": "object"
    },
    "GatewayErrorKind": {
      "description": "Clases de falla del gateway de LLM (M0 §2.11).",
      "enum": [
        "timeout",
        "unavailable",
        "rate_limited",
        "invalid_output",
        "refused"
      ],
      "title": "GatewayErrorKind",
      "type": "string"
    },
    "ToolStatus": {
      "description": "Estado del resultado de una tool (M0 §2.8).",
      "enum": [
        "ok",
        "error",
        "timeout",
        "denied",
        "uncertain",
        "step_up_required"
      ],
      "title": "ToolStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Payload del evento `agent_step` (vista audit, M0 §2.10, ADR 0019).\n\nUn paso del nodo `agent`. Los argumentos y el resultado de una tool van en su `tool_called` (`call_id`\nlos enlaza); el texto de la respuesta final solo como huella con clave, nunca razonamiento intermedio.\n`kind = \"failed\"`: el gateway falló en ese paso y el nodo terminó en `gave_up`.",
  "properties": {
    "call_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Call Id"
    },
    "error_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/GatewayErrorKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "enum": [
        "tool",
        "final",
        "failed"
      ],
      "title": "Kind",
      "type": "string"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "node_id": {
      "pattern": "^[a-z0-9][a-z0-9_]*$",
      "title": "Node Id",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "step": {
      "exclusiveMinimum": 0,
      "title": "Step",
      "type": "integer"
    },
    "text_fp": {
      "anyOf": [
        {
          "$ref": "#/$defs/Fingerprint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tool": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntityRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "node_id",
    "step",
    "kind",
    "latency_ms"
  ],
  "title": "AgentStepPayload",
  "type": "object"
}
