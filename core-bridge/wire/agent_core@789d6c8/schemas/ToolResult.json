{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "AuthLevel": {
      "description": "Nivel de autenticación; se compara por rango (`anonymous < session < step_up`).",
      "enum": [
        "anonymous",
        "session",
        "step_up"
      ],
      "title": "AuthLevel",
      "type": "string"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ToolStatus": {
      "description": "Estado del resultado de una tool (M0 §2.8).",
      "enum": [
        "ok",
        "error",
        "timeout",
        "denied",
        "uncertain",
        "step_up_required"
      ],
      "title": "ToolStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Solo `result_full` y su `source`: las vistas `model`/`audit` las calcula M7 (M0 rev. 2).",
  "properties": {
    "call_id": {
      "title": "Call Id",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "required_level": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthLevel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result_full": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "status": {
      "$ref": "#/$defs/ToolStatus"
    }
  },
  "required": [
    "status",
    "call_id"
  ],
  "title": "ToolResult",
  "type": "object"
}
