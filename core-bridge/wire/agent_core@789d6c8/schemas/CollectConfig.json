{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "RefSpec": {
      "additionalProperties": false,
      "description": "Referencia de autoría: exacta, rango (`^1`, `~1.2`, `1`) o sin versión.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "spec": {
          "anyOf": [
            {
              "pattern": "^(?:(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)|[\\^~](?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}|(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spec"
        }
      },
      "required": [
        "id"
      ],
      "title": "RefSpec",
      "type": "object"
    },
    "SlotValidator": {
      "additionalProperties": false,
      "description": "Validador de un slot recolectado (M0 §2.5).",
      "properties": {
        "kind": {
          "enum": [
            "type",
            "regex",
            "enum",
            "decide"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "SlotValidator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Configuración del nodo `collect` (M0 §2.5).",
  "properties": {
    "max_attempts": {
      "default": 2,
      "exclusiveMinimum": 0,
      "title": "Max Attempts",
      "type": "integer"
    },
    "prompt_ref": {
      "$ref": "#/$defs/RefSpec"
    },
    "slot": {
      "title": "Slot",
      "type": "string"
    },
    "validator": {
      "anyOf": [
        {
          "$ref": "#/$defs/SlotValidator"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "slot",
    "prompt_ref"
  ],
  "title": "CollectConfig",
  "type": "object"
}
