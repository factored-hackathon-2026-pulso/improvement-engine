{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "EntityRef": {
      "additionalProperties": false,
      "description": "Referencia exacta de runtime: `id@X.Y.Z`.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "Flow activo del run: nodo actual y slots locales (M0 §2.6).",
  "properties": {
    "flow": {
      "$ref": "#/$defs/EntityRef"
    },
    "local_slots": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Local Slots",
      "type": "object"
    },
    "node_id": {
      "pattern": "^[a-z0-9][a-z0-9_]*$",
      "title": "Node Id",
      "type": "string"
    }
  },
  "required": [
    "flow",
    "node_id"
  ],
  "title": "ActiveFlow",
  "type": "object"
}
