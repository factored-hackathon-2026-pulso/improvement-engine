{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "JsonValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "RefSpec": {
      "additionalProperties": false,
      "description": "Referencia de autoría: exacta, rango (`^1`, `~1.2`, `1`) o sin versión.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "spec": {
          "anyOf": [
            {
              "pattern": "^(?:(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)|[\\^~](?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}|(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spec"
        }
      },
      "required": [
        "id"
      ],
      "title": "RefSpec",
      "type": "object"
    },
    "ToolConfig": {
      "additionalProperties": false,
      "description": "Configuración del nodo `tool` (M0 §2.5).",
      "properties": {
        "args": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Args",
          "type": "object"
        },
        "save_as": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Save As",
          "type": "string"
        },
        "step_up_max_attempts": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Step Up Max Attempts",
          "type": "integer"
        },
        "tool": {
          "$ref": "#/$defs/RefSpec"
        }
      },
      "required": [
        "tool",
        "save_as"
      ],
      "title": "ToolConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Nodo `tool` de un flow (M0 §2.5).",
  "properties": {
    "config": {
      "$ref": "#/$defs/ToolConfig"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "next": {
      "additionalProperties": {
        "pattern": "^[a-z0-9][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Next",
      "type": "object"
    },
    "type": {
      "const": "tool",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "config"
  ],
  "title": "ToolNode",
  "type": "object"
}
