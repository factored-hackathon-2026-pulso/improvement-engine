{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "RefSpec": {
      "additionalProperties": false,
      "description": "Referencia de autoría: exacta, rango (`^1`, `~1.2`, `1`) o sin versión.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "spec": {
          "anyOf": [
            {
              "pattern": "^(?:(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)|[\\^~](?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}|(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spec"
        }
      },
      "required": [
        "id"
      ],
      "title": "RefSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Resultados = valores del enum de `branch_on` + `low_confidence`, cableados en `next` (rev. 4).",
  "properties": {
    "branch_on": {
      "title": "Branch On",
      "type": "string"
    },
    "choices_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Choices From"
    },
    "input_view": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input View"
    },
    "model": {
      "$ref": "#/$defs/RefSpec"
    },
    "save_as": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Save As",
      "type": "string"
    }
  },
  "required": [
    "model",
    "branch_on",
    "save_as"
  ],
  "title": "DecideConfig",
  "type": "object"
}
