{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "AuthInfo": {
      "additionalProperties": false,
      "description": "Nivel de autenticación de un principal y el instante en que lo obtuvo (ADR 0010).",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/AuthLevel"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "level",
        "at"
      ],
      "title": "AuthInfo",
      "type": "object"
    },
    "AuthLevel": {
      "description": "Nivel de autenticación; se compara por rango (`anonymous < session < step_up`).",
      "enum": [
        "anonymous",
        "session",
        "step_up"
      ],
      "title": "AuthLevel",
      "type": "string"
    },
    "OnBehalfOf": {
      "additionalProperties": false,
      "description": "Delegación firmada por el emisor de asignaciones, atada al asesor `grantee` (ADR 0006).",
      "properties": {
        "exp": {
          "format": "date-time",
          "title": "Exp",
          "type": "string"
        },
        "grant_ref": {
          "minLength": 1,
          "title": "Grant Ref",
          "type": "string"
        },
        "grantee": {
          "$ref": "#/$defs/PrincipalKey"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "subject": {
          "$ref": "#/$defs/SubjectRef"
        }
      },
      "required": [
        "subject",
        "grant_ref",
        "grantee",
        "exp"
      ],
      "title": "OnBehalfOf",
      "type": "object"
    },
    "Principal": {
      "additionalProperties": false,
      "description": "Quien invoca, ya verificado por M9. Snapshot sin credencial ni secretos.",
      "properties": {
        "attrs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attrs",
          "type": "object"
        },
        "auth": {
          "$ref": "#/$defs/AuthInfo"
        },
        "exp": {
          "format": "date-time",
          "title": "Exp",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "type": {
          "$ref": "#/$defs/PrincipalType"
        }
      },
      "required": [
        "type",
        "auth",
        "exp"
      ],
      "title": "Principal",
      "type": "object"
    },
    "PrincipalKey": {
      "additionalProperties": false,
      "description": "Identidad comparable de un principal (tipo e id), sin credenciales (M0 §2.3).",
      "properties": {
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "type": {
          "$ref": "#/$defs/PrincipalType"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "PrincipalKey",
      "type": "object"
    },
    "PrincipalType": {
      "description": "Tipo de principal que invoca el motor (ADR 0006, M0 §2.3).",
      "enum": [
        "customer",
        "advisor",
        "service",
        "builder"
      ],
      "title": "PrincipalType",
      "type": "string"
    },
    "SubjectRef": {
      "additionalProperties": false,
      "description": "Referencia al sujeto de un run (tipo y referencia opaca) (M0 §2.3).",
      "properties": {
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "SubjectRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Contexto de una llamada a tool: run, release, principal y sujeto (M0 §2.9).",
  "properties": {
    "on_behalf_of": {
      "anyOf": [
        {
          "$ref": "#/$defs/OnBehalfOf"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "principal": {
      "$ref": "#/$defs/Principal"
    },
    "release": {
      "title": "Release",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "subject": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubjectRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "turn_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Id"
    }
  },
  "required": [
    "run_id",
    "release",
    "principal"
  ],
  "title": "ToolCallContext",
  "type": "object"
}
