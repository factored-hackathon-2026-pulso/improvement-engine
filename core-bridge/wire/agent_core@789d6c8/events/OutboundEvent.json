{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "EntityRef": {
      "additionalProperties": false,
      "description": "Referencia exacta de runtime: `id@X.Y.Z`.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "HandoffCreatedData": {
      "additionalProperties": false,
      "properties": {
        "handoff_ref": {
          "title": "Handoff Ref",
          "type": "string"
        },
        "language": {
          "pattern": "^[a-z]{2}$",
          "title": "Language",
          "type": "string"
        },
        "priority": {
          "title": "Priority",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "target_queue": {
          "title": "Target Queue",
          "type": "string"
        }
      },
      "required": [
        "handoff_ref",
        "target_queue",
        "priority",
        "reason_code",
        "language"
      ],
      "title": "HandoffCreatedData",
      "type": "object"
    },
