          "default": null,
          "title": "Session Id"
        },
        "source": {
          "const": "engine",
          "default": "engine",
          "title": "Source",
          "type": "string"
        },
        "spec_version": {
          "const": 1,
          "default": 1,
          "title": "Spec Version",
          "type": "integer"
