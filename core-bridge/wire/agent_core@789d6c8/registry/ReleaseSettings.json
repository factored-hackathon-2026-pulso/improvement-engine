          "type": "string"
        }
      },
      "required": [
        "type",
        "flow"
      ],
      "title": "StartFlowAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Contenido del borrador `release_settings`. Un campo omitido conserva el valor de la base; no hay forma\nde quitar el `injection_ruleset` ni la detección de idioma, solo de cambiarlos por otros del registry.",
