          "default": null
        }
      },
      "required": [
        "id",
        "priority",
        "action"
      ],
      "title": "Interrupt",
      "type": "object"
    },
    "RefSpec": {
      "additionalProperties": false,
      "description": "Referencia de autoría: exacta, rango (`^1`, `~1.2`, `1`) o sin versión.",
