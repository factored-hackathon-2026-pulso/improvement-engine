      "properties": {
        "action": {
          "discriminator": {
            "mapping": {
              "escalate": "#/$defs/EscalateAction",
              "start_flow": "#/$defs/StartFlowAction"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/EscalateAction"
            },
            {
              "$ref": "#/$defs/StartFlowAction"
            }
          ],
          "title": "Action"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "title": "Priority",
          "type": "integer"
        },
        "signal_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefSpec"
            },
            {
              "type": "null"
            }
