{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "EntityRef": {
      "additionalProperties": false,
      "description": "Referencia exacta de runtime: `id@X.Y.Z`.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "EntityRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Resumen de un run para la ingesta: identificadores y estado, sin datos del cliente.",
  "properties": {
    "agent": {
      "$ref": "#/$defs/EntityRef"
    },
    "closed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Closed At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cursor": {
      "title": "Cursor",
      "type": "integer"
    },
    "locale": {
      "title": "Locale",
      "type": "string"
    },
    "mode": {
      "title": "Mode",
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Outcome"
    },
    "principal_type": {
      "title": "Principal Type",
      "type": "string"
    },
    "release": {
      "title": "Release",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "run_seq": {
      "title": "Run Seq",
      "type": "integer"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Session Id"
    },
    "status": {
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "run_seq",
    "cursor",
    "run_id",
    "session_id",
    "release",
    "agent",
    "principal_type",
    "mode",
    "locale",
    "status",
    "outcome",
    "created_at",
    "closed_at"
  ],
  "title": "RunSummary",
  "type": "object"
}
