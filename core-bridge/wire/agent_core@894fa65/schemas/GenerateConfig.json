{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "RefSpec": {
      "additionalProperties": false,
      "description": "Referencia de autoría: exacta, rango (`^1`, `~1.2`, `1`) o sin versión.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "spec": {
          "anyOf": [
            {
              "pattern": "^(?:(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)|[\\^~](?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}|(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spec"
        }
      },
      "required": [
        "id"
      ],
      "title": "RefSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Configuración del nodo `generate` (M0 §2.5).\n\n`knowledge_from` lista los `save_as` de nodos `knowledge` cuyas páginas puede citar la respuesta, y\n`purpose` dice para quién es (M12 §2: reemplaza a `knowledge_refs`). El defecto es el más estricto.",
  "properties": {
    "allowed_facts": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Facts",
      "type": "array"
    },
    "fallback_template_ref": {
      "$ref": "#/$defs/RefSpec"
    },
    "knowledge_from": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Knowledge From",
      "type": "array"
    },
    "prompt_ref": {
      "$ref": "#/$defs/RefSpec"
    },
    "purpose": {
      "default": "customer_answer",
      "enum": [
        "customer_answer",
        "advisor_view",
        "agent_guidance"
      ],
      "title": "Purpose",
      "type": "string"
    }
  },
  "required": [
    "prompt_ref",
    "fallback_template_ref"
  ],
  "title": "GenerateConfig",
  "type": "object"
}
