{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "EntityRef": {
      "additionalProperties": false,
      "description": "Referencia exacta de runtime: `id@X.Y.Z`.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "EntityRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Metric graded by an LLM judge: the only non-deterministic kind (ADR 0020).",
  "properties": {
    "judge_profile": {
      "$ref": "#/$defs/EntityRef"
    },
    "rubric": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Rubric",
      "type": "string"
    },
    "target_event": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Target Event",
      "type": "string"
    }
  },
  "required": [
    "judge_profile",
    "rubric",
    "target_event"
  ],
  "title": "JudgeExpr",
  "type": "object"
}
