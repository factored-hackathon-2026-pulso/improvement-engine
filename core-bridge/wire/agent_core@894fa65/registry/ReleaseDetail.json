{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "EntityInRelease": {
      "additionalProperties": false,
      "properties": {
        "changed_vs_base": {
          "title": "Changed Vs Base",
          "type": "boolean"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "docs": {
          "$ref": "#/$defs/VersionDocs"
        },
        "ref": {
          "$ref": "#/$defs/VersionRef"
        }
      },
      "required": [
        "ref",
        "content_hash",
        "docs",
        "changed_vs_base"
      ],
      "title": "EntityInRelease",
      "type": "object"
    },
    "EntityRef": {
      "additionalProperties": false,
      "description": "Referencia exacta de runtime: `id@X.Y.Z`.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "EscalateAction": {
      "additionalProperties": false,
      "description": "Acción de una interrupción que escala a una cola (M0 §2.4).",
      "properties": {
        "priority": {
          "title": "Priority",
          "type": "string"
        },
        "target_queue": {
          "title": "Target Queue",
          "type": "string"
        },
        "type": {
          "const": "escalate",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "target_queue",
        "priority"
      ],
      "title": "EscalateAction",
      "type": "object"
    },
    "Interrupt": {
      "additionalProperties": false,
      "description": "Interrupción de una release: prioridad y acción (escalar o iniciar un flow) (M0 §2.4).",
      "properties": {
        "action": {
          "discriminator": {
            "mapping": {
              "escalate": "#/$defs/EscalateAction",
              "start_flow": "#/$defs/StartFlowAction"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/EscalateAction"
            },
            {
              "$ref": "#/$defs/StartFlowAction"
            }
          ],
          "title": "Action"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "priority": {
          "title": "Priority",
          "type": "integer"
        },
        "signal_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "priority",
        "action"
      ],
      "title": "Interrupt",
      "type": "object"
    },
    "RefSpec": {
      "additionalProperties": false,
      "description": "Referencia de autoría: exacta, rango (`^1`, `~1.2`, `1`) o sin versión.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_/-]*$",
          "title": "Id",
          "type": "string"
        },
        "spec": {
          "anyOf": [
            {
              "pattern": "^(?:(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)|[\\^~](?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)){0,2}|(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spec"
        }
      },
      "required": [
        "id"
      ],
      "title": "RefSpec",
      "type": "object"
    },
    "StartFlowAction": {
      "additionalProperties": false,
      "description": "Acción de una interrupción que inicia un flow (M0 §2.4).",
      "properties": {
        "flow": {
          "$ref": "#/$defs/RefSpec"
        },
        "type": {
          "const": "start_flow",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "flow"
      ],
      "title": "StartFlowAction",
      "type": "object"
    },
    "VersionDocs": {
      "additionalProperties": false,
      "properties": {
        "changelog": {
          "maxLength": 8000,
          "title": "Changelog",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "description",
        "rationale",
        "changelog"
      ],
      "title": "VersionDocs",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "title": "Agent Id",
      "type": "string"
    },
    "base_release_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Base Release Id"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/EntityInRelease"
      },
      "title": "Entities",
      "type": "array"
    },
    "eval_suite_refs": {
      "items": {
        "$ref": "#/$defs/VersionRef"
      },
      "title": "Eval Suite Refs",
      "type": "array"
    },
    "injection_ruleset": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntityRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "interrupts": {
      "items": {
        "$ref": "#/$defs/Interrupt"
      },
      "title": "Interrupts",
      "type": "array"
    },
    "knowledge_snapshot": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Knowledge Snapshot"
    },
    "language_detection": {
      "$ref": "#/$defs/EntityRef"
    },
    "max_input_chars": {
      "title": "Max Input Chars",
      "type": "integer"
    },
    "proposal_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Proposal Id"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "published_by": {
      "title": "Published By",
      "type": "string"
    },
    "release_id": {
      "title": "Release Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "revoked"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "release_id",
    "status",
    "agent_id",
    "entities",
    "knowledge_snapshot",
    "proposal_id",
    "base_release_id",
    "published_by",
    "published_at",
    "language_detection",
    "max_input_chars"
  ],
  "title": "ReleaseDetail",
  "type": "object"
}
