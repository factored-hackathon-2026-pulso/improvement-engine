{
  "$comment": "GENERADO por `uv run agentcore contracts`; no editar a mano.",
  "$defs": {
    "VersionDocs": {
      "additionalProperties": false,
      "properties": {
        "changelog": {
          "maxLength": 8000,
          "title": "Changelog",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "description",
        "rationale",
        "changelog"
      ],
      "title": "VersionDocs",
      "type": "object"
    },
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "after": {
      "$ref": "#/$defs/VersionRef"
    },
    "before": {
      "$ref": "#/$defs/VersionRef"
    },
    "docs": {
      "$ref": "#/$defs/VersionDocs"
    }
  },
  "required": [
    "before",
    "after",
    "docs"
  ],
  "title": "ChangedRef",
  "type": "object"
}
