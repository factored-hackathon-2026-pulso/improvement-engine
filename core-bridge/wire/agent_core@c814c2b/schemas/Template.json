        }
      },
      "title": "Locales",
      "type": "object"
    },
    "reads": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Reads",
      "type": "array",
      "uniqueItems": true
    },
    "version": {
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "locales"
  ],
  "title": "Template",
  "type": "object"
}
